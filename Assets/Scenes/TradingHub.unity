      m_Calls: []
  m_text: "<color=#D9AE52>Loadout 1 Balanced ----------------------------------------------------\r\n                
    Letter, Verdant Maw, Cosmic Claws</color>\r\n<color=#E0702C>Loadout 2 High DPS----------------------------------------------------\r\n                  
    Letter, Cosmic Claws, Death Cannon</color>\r\n<color=#5F9E6E>Loadout 3 Status
    Effects-----------------------------------------------\r\n                  
    Verdant Maw, Letter, Death Cannon</color>\r\n<color=#8B9AA5>Loadout 4 Scaling/Ramp----------------------------------------------\r\n                  
    Letter, Cosmic Claws, Starcaller</color>\n\n<color=#C9C4B8>Letter</color> \u2014
    Basic sword, shoots a shockwave.\n\r\n<color=#5F9E6E>Verdant Maw</color> \u2014
    Poisons on hit. Charge attack poisons enemies in AOE\n\r\n<color=#A97BFF>Cosmic
    Claws</color> \u2014 Melee range basic attack, Charge attack unleashes a flurry
    of slashes.\n\r\n<color=#D9AE52>Starcaller</color> \u2014 Slow projectile attack.
    Chance to return ember on hit.\n\r\n<color=#E0702C>Death Cannon</color> \u2014
    Fast projectile, explodes on impact.\n\n!!!CHARGE ATTACKS ACTIVATE BY HOLDING
    LEFT MOUSE BUTTON!!!"
